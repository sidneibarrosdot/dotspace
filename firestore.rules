rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isDotGroupUser() {
      return isAuthenticated() && 
             request.auth.token.email != null && 
             request.auth.token.email.lower().matches('.*@dotgroup\\.com\\.br$');
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email != null &&
             (
               (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
               (request.auth.token.email.lower() == "sidnei.barros@dotgroup.com.br" && request.auth.token.email_verified == true)
             );
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['userEmail', 'action', 'details', 'version', 'timestamp']) &&
             data.userEmail is string && data.userEmail.size() < 100 &&
             data.action is string && data.action.size() < 50 &&
             data.details is string && data.details.size() < 1000 &&
             data.version is string && data.version.size() < 20 &&
             data.timestamp is timestamp;
    }

    // Check if only likes or views are being updated
    function isOnlyUpdatingLikesOrViews(projectId) {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let likeId = request.auth.uid + "_" + projectId;
      
      return affectedKeys.hasOnly(['likes', 'views']) &&
             (!affectedKeys.hasAny(['views']) || math.abs(request.resource.data.views - resource.data.get('views', 0)) == 1) &&
             (!affectedKeys.hasAny(['likes']) || (
               math.abs(request.resource.data.likes - resource.data.get('likes', 0)) == 1 &&
               (
                 (request.resource.data.likes > resource.data.get('likes', 0) && 
                  !exists(/databases/$(database)/documents/likes/$(likeId)) && 
                  getAfter(/databases/$(database)/documents/likes/$(likeId)) != null) ||
                 (request.resource.data.likes < resource.data.get('likes', 0) && 
                  exists(/databases/$(database)/documents/likes/$(likeId)) && 
                  getAfter(/databases/$(database)/documents/likes/$(likeId)) == null)
               )
             ));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Projects collection
    match /projects/{projectId} {
      allow read: if isDotGroupUser();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isDotGroupUser() && isOnlyUpdatingLikesOrViews(projectId));
    }
    
    // Access logs
    match /accessLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isDotGroupUser();
    }
    
    // Audit logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isDotGroupUser() && isValidAuditLog(request.resource.data);
    }
    
    // Upload logs
    match /uploadLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }
    
    // User profiles
    match /users/{userId} {
      allow read: if isDotGroupUser() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // App Config
    match /config/{docId} {
      allow read: if isDotGroupUser();
      allow write: if isAdmin();
    }

    // Favorites collection
    match /favorites/{favoriteId} {
      allow read: if isDotGroupUser() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isDotGroupUser() && request.resource.data.userId == request.auth.uid;
      allow delete: if isDotGroupUser() && resource.data.userId == request.auth.uid;
    }

    // Likes collection
    match /likes/{likeId} {
      allow read: if isDotGroupUser();
      allow create: if isDotGroupUser() && 
                      request.resource.data.userId == request.auth.uid &&
                      likeId == request.auth.uid + "_" + request.resource.data.projectId;
      allow delete: if isDotGroupUser() && resource.data.userId == request.auth.uid;
    }

    // Shared project selections
    match /shares/{shareId} {
      allow read: if isDotGroupUser();
      allow create: if isDotGroupUser();
      allow update, delete: if false;
    }
  }
}
